{
  "name": "komari-nodeget-compat",
  "version": "0.4.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "bin": {
    "komari-nodeget-convert": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "convert": "bun run src/cli.ts",
    "dev": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "prewarm": "bun run scripts/prewarm-themes.ts",
    "setup:r2": "bun run scripts/ensure-r2.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "parse5": "^7.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "lucide": "^1.34.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.125.0"
  }
}
