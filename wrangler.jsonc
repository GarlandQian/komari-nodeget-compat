{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "komari-nodeget-theme-adapter",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-25",
  "keep_vars": true,
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/themes/*"]
  },
  "r2_buckets": [
    {
      "binding": "THEME_CACHE",
      "bucket_name": "komari-nodeget-theme-cache"
    }
  ],
  "observability": {
    "enabled": true
  }
}
